<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 2026-07-30 aggiunti i blocchi collision (stessa mesh/geometria del
       visual, pattern identico al kr810 ufficiale del driver). Prima erano
       assenti e MoveIt non controllava nessuna autocollisione del braccio. -->
  <xacro:macro name="kr1018_description" params="prefix parent *origin">

    <!-- joint di aggancio al link parent -->
    <joint name="${prefix}_parent_link" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}_base"/>
    </joint>

    <!-- links -->
    <link name="${prefix}_base">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0.1365"/>
        <mass value="8.2"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.035"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_BaseEdge.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.035"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_BaseEdge.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_link2">
      <inertial>
        <origin rpy="1.5707963267948966 0 0" xyz="0.062 0 0.35619999999999996"/>
        <mass value="10.2"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0.062 0 0.357"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0.062 0 0.357"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_linkJ3">
      <visual>
        <origin rpy="1.5707963267948966 0 0" xyz="0 -0.006 0"/>
        <geometry>
          <cylinder length="0.15" radius="0.015"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin rpy="1.5707963267948966 0 0" xyz="0 -0.006 0"/>
        <geometry>
          <cylinder length="0.15" radius="0.015"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="-0.062 0.1052 0.20495"/>
        <mass value="1.3"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
    </link>

    <link name="${prefix}_link3">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0.3396"/>
        <mass value="4.7"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0.00 0.17"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0.00 0.17"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_link4">
      <inertial>
        <origin rpy="-1.5707963267948966 0 0" xyz="0.05 0 0.1829"/>
        <mass value="5.78"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0.05 0 0.1829"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0.05 0 0.1829"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_linkJ5">
      <visual>
        <origin rpy="1.5707963267948966 0 0" xyz="0 0.005 0"/>
        <geometry>
          <cylinder length="0.12" radius="0.015"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin rpy="1.5707963267948966 0 0" xyz="0 0.005 0"/>
        <geometry>
          <cylinder length="0.12" radius="0.015"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="-0.05 -0.0857 0.1986"/>
        <mass value="0.75"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
    </link>

    <link name="${prefix}_link5">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0.3764"/>
        <mass value="1.5"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
      <visual>
        <origin rpy="3.1415926535 1.570796326795 0" xyz="0.126 0.0535 0.431"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="3.1415926535 1.570796326795 0" xyz="0.126 0.0535 0.431"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_link6">
      <inertial>
        <origin rpy="1.5707963267948966 0 0" xyz="0 0 0.1011"/>
        <mass value="1.7"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0.002 0.1011"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link6.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0.002 0.1011"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link6.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_linkJ7">
      <visual>
        <origin rpy="1.5707963267948966 0 0" xyz="0 0.01 0"/>
        <geometry>
          <cylinder length="0.105" radius="0.015"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="1.5707963267948966 0 0" xyz="0 0.01 0"/>
        <geometry>
          <cylinder length="0.105" radius="0.015"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="0.0"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
    </link>

    <link name="${prefix}_link7">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="1.76"/>
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.002"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link7.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.002"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_Link7.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_end_effector">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 -0.1051"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_ToolIO.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="">
          <color rgba="0.8 0.8 0.8 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 -0.1051"/>
        <geometry>
          <mesh filename="package://kassow_kord_description/kr1018/meshes/collision/a1018_ToolIO.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- joints -->
    <joint name="${prefix}_joint_1" type="revolute">
      <parent link="${prefix}_base"/>
      <child link="${prefix}_link2"/>
      <origin rpy="0.0 -0.0 0.0" xyz="0 0 0.035"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0"/>
      <limit effort="500" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.8361600344907854"/>
    </joint>

    <joint name="${prefix}_joint_2" type="revolute">
      <parent link="${prefix}_link2"/>
      <child link="${prefix}_linkJ3"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.062 0.0 0.3562"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="1.0"/>
      <limit effort="500" lower="-1.2217304763960306" upper="3.141592653589793" velocity="2.8361600344907854"/>
    </joint>

    <joint name="${prefix}_jointPL3" type="fixed">
      <parent link="${prefix}_linkJ3"/>
      <child link="${prefix}_link3"/>
      <origin rpy="0.0 -0.0 0.0" xyz="-0.062 0.1052 0"/>
    </joint>

    <joint name="${prefix}_joint_3" type="revolute">
      <parent link="${prefix}_link3"/>
      <child link="${prefix}_link4"/>
      <origin rpy="0 0 0" xyz="0 0 0.3396"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0"/>
      <limit effort="204" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.9269908169872414"/>
    </joint>

    <joint name="${prefix}_joint_4" type="revolute">
      <parent link="${prefix}_link4"/>
      <child link="${prefix}_linkJ5"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.05 0.0 0.1829"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="1.0"/>
      <limit effort="204" lower="-1.2217304763960306" upper="3.141592653589793" velocity="3.9269908169872414"/>
    </joint>

    <joint name="${prefix}_jointPL5" type="fixed">
      <parent link="${prefix}_linkJ5"/>
      <child link="${prefix}_link5"/>
      <origin rpy="0.0 -0.0 0.0" xyz="-0.05 -0.0857 0.0"/>
    </joint>

    <joint name="${prefix}_joint_5" type="revolute">
      <parent link="${prefix}_link5"/>
      <child link="${prefix}_link6"/>
      <origin rpy="0 0 0" xyz="0 0 0.3764"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0"/>
      <limit effort="80" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.9269908169872414"/>
    </joint>

    <joint name="${prefix}_joint_6" type="revolute">
      <parent link="${prefix}_link6"/>
      <child link="${prefix}_linkJ7"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0 0.1011"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="1.0"/>
      <limit effort="80" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.9269908169872414"/>
    </joint>

    <joint name="${prefix}_jointPL7" type="fixed">
      <parent link="${prefix}_linkJ7"/>
      <child link="${prefix}_link7"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.111 0"/>
    </joint>

    <joint name="${prefix}_joint_7" type="revolute">
      <parent link="${prefix}_link7"/>
      <child link="${prefix}_end_effector"/>
      <origin rpy="0 0 0" xyz="0 0 0.108"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0"/>
      <limit effort="80" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.9269908169872414"/>
    </joint>

  </xacro:macro>

</robot>
