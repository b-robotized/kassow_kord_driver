<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="kassow_kord_ros2_control"
              params="name
                      prefix
                      ros2_control_hardware_type:=mock
                      ip_address:=10.23.23.238
                      port:=28283
                      session_id:=1
                      waitSync_timeout_ms:=8
                      is_async:=false
                      scheduling_policy:=detached
                      thread_priority:=50
                      cpu_affinity:=''"
                      >

    <ros2_control name="${name}" type="system" is_async="${is_async}" rw_rate="250">
      <xacro:if value="${is_async == 'true'}">
        <properties>
          <async scheduling_policy="${scheduling_policy}" print_warnings="true" thread_priority="${thread_priority}" affinity="${cpu_affinity}"/>
        </properties>
      </xacro:if>
      <hardware>
        <xacro:if value="${ros2_control_hardware_type == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${ros2_control_hardware_type == 'real'}">
          <plugin>kassow_kord_hardware_interface/KassowKordHardwareInterface</plugin>
          <param name="ip_address">${ip_address}</param>
          <param name="port">${port}</param>
          <param name="session_id">${session_id}</param>
          <param name="waitSync_timeout_ms">${waitSync_timeout_ms}</param>
        </xacro:if>
      </hardware>

      <joint name="${prefix}_joint_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
        <state_interface name="effort_external"/>
      </joint>

      <joint name="${prefix}_joint_2">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
        <state_interface name="effort_external"/>
      </joint>

      <joint name="${prefix}_joint_3">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
        <state_interface name="effort_external"/>
      </joint>

      <joint name="${prefix}_joint_4">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
        <state_interface name="effort_external"/>
      </joint>

      <joint name="${prefix}_joint_5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
        <state_interface name="effort_external"/>
      </joint>

      <joint name="${prefix}_joint_6">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
        <state_interface name="effort_external"/>
      </joint>

      <joint name="${prefix}_joint_7">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
        <state_interface name="effort"/>
        <state_interface name="effort_external"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
