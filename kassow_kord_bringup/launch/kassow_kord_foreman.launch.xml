<launch>
    <arg name="description_package"
        default="kassow_kord_bringup"
        description="Description package with robot URDF/xacro files. Usually not set, it enables use of a custom description."/>
    <arg name="ros2_control_hardware_type"
         default="mock"
         description="Hardware type: mock, real, or isaac."/>

    <let name="cm_name" value="b_controlled_box_cm"/>
    <let name="foreman_config_path" value="$(find-pkg-share $(var description_package))/config/foreman_$(var ros2_control_hardware_type)_config.yaml"/>

    <node name="foreman" pkg="foreman" exec="foreman_node" output="screen">
      <param name="config_path" value="$(var foreman_config_path)"/>
      <remap from="/controller_manager/activity" to="/$(var cm_name)/activity"/>
      <remap from="/controller_manager/switch_controller" to="/$(var cm_name)/switch_controller"/>
      <remap from="/controller_manager/set_hardware_component_state" to="/$(var cm_name)/set_hardware_component_state"/>
      <remap from="/controller_manager/list_controllers" to="/$(var cm_name)/list_controllers"/>
      <remap from="/controller_manager/list_hardware_components" to="/$(var cm_name)/list_hardware_components"/>
      <remap from="/controller_manager/configure_controller" to="/$(var cm_name)/configure_controller"/>
      <remap from="/controller_manager/activate_controller" to="/$(var cm_name)/activate_controller"/>
      <remap from="/controller_manager/deactivate_controller" to="/$(var cm_name)/deactivate_controller"/>
    </node>
</launch>
